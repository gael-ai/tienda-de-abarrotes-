@model AbarrotesInventory.Application.Interfaces.DashboardDto
@* archivo: index.cshtml | función: vista principal del módulo home, utilizada para mostrar y administrar sus registros. *@
@{ViewData["Title"]="Dashboard";}
<div class="page-title-row"><div><h3 class="mb-1">Resumen general</h3><span class="text-secondary">Indicadores principales del negocio</span></div><a class="btn btn-primary" href="/Sales/Create"><i class="bi bi-plus-lg"></i> Nueva venta</a></div>
<div class="row g-3"><div class="col-xl-3 col-md-6"><div class="card stat-card"><div><small>Productos activos</small><h3>@Model.Products</h3></div><div class="icon"><i class="bi bi-box"></i></div></div></div><div class="col-xl-3 col-md-6"><div class="card stat-card"><div><small>Stock bajo</small><h3>@Model.LowStock</h3></div><div class="icon"><i class="bi bi-exclamation-triangle"></i></div></div></div><div class="col-xl-3 col-md-6"><div class="card stat-card"><div><small>Ventas de hoy</small><h3>S/ @Model.SalesToday.ToString("N2")</h3></div><div class="icon"><i class="bi bi-graph-up-arrow"></i></div></div></div><div class="col-xl-3 col-md-6"><div class="card stat-card"><div><small>Compras de hoy</small><h3>S/ @Model.PurchasesToday.ToString("N2")</h3></div><div class="icon"><i class="bi bi-bag"></i></div></div></div></div>
<div class="row g-3 mt-1"><div class="col-lg-8"><div class="table-card"><h5>Accesos rápidos</h5><p class="text-secondary">Registra las operaciones más frecuentes.</p><div class="d-flex gap-2 flex-wrap"><a href="/Sales/Create" class="btn btn-primary"><i class="bi bi-cart-plus"></i> Registrar venta</a><a href="/Purchases/Create" class="btn btn-outline-primary"><i class="bi bi-bag-plus"></i> Registrar compra</a><a href="/Products/Create" class="btn btn-outline-secondary"><i class="bi bi-box-seam"></i> Nuevo producto</a><a href="/Inventory" class="btn btn-outline-secondary"><i class="bi bi-clock-history"></i> Kardex</a></div></div></div><div class="col-lg-4"><div class="table-card"><h5>Maestros</h5><div class="d-flex justify-content-between py-2 border-bottom"><span>Categorías</span><b>@Model.Categories</b></div><div class="d-flex justify-content-between py-2 border-bottom"><span>Proveedores</span><b>@Model.Suppliers</b></div><div class="d-flex justify-content-between py-2"><span>Clientes</span><b>@Model.Customers</b></div></div></div></div>