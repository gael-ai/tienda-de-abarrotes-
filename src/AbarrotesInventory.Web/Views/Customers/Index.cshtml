@model IEnumerable<AbarrotesInventory.Domain.Entities.Customer>
@* archivo: index.cshtml | función: vista principal del módulo customers, utilizada para mostrar y administrar sus registros. *@
@{ViewData["Title"]="Clientes";}<h2>Clientes</h2><form method="post" action="/Customers/Save" class="row g-2 mb-4"><div class="col"><input class="form-control" name="Name" placeholder="Name" required></div><div class="col"><input class="form-control" name="Document" placeholder="Document" required></div><div class="col"><input class="form-control" name="Phone" placeholder="Phone" required></div><div class="col"><input class="form-control" name="Email" placeholder="Email" required></div><div class="col"><input class="form-control" name="Address" placeholder="Address" required></div><div class="col-auto"><button class="btn btn-primary">Agregar</button></div></form><table class="table"><thead><tr><th>Name</th><th>Document</th><th>Phone</th><th>Email</th><th>Address</th><th></th></tr></thead><tbody>@foreach(var e in Model.Where(x=>x.Active)){<tr><td>@e.Name</td><td>@e.Document</td><td>@e.Phone</td><td>@e.Email</td><td>@e.Address</td><td><form method="post" action="/Customers/Delete/{e.Id}"><button class="btn btn-sm btn-danger">Eliminar</button></form></td></tr>}</tbody></table>