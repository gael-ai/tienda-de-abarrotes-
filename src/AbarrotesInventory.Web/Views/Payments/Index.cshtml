@model IEnumerable<AbarrotesInventory.Domain.Entities.Payment>
@* archivo: index.cshtml | función: vista principal del módulo payments, utilizada para mostrar y administrar sus registros. *@
@{ViewData["Title"]="Pagos";}<div class="page-title-row"><div><h3 class="mb-1">Registro de pagos</h3><span class="text-secondary">Pagos generados por las ventas</span></div></div><div class="table-card"><table class="table table-hover"><thead><tr><th>Fecha</th><th>Venta</th><th>Método</th><th class="text-end">Monto</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Date.ToString("dd/MM/yyyy HH:mm")</td><td>@x.Sale?.Number</td><td>@x.Method</td><td class="text-end fw-bold">S/ @x.Amount.ToString("N2")</td></tr>}</tbody></table></div>