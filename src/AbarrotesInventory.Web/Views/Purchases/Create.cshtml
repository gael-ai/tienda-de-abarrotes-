@* archivo: create.cshtml | función: vista del módulo purchases utilizada para registrar un nuevo elemento. *@
@{ViewData["Title"]="Nueva compra";var products=(IEnumerable<AbarrotesInventory.Domain.Entities.Product>)ViewBag.Products;var suppliers=(IEnumerable<AbarrotesInventory.Domain.Entities.Supplier>)ViewBag.Suppliers;}<div class="page-title-row"><div><h3>Registrar compra</h3><span class="text-secondary">El stock se incrementará automáticamente</span></div><a href="/Purchases" class="btn btn-outline-secondary">Volver</a></div><div class="card p-4"><form method="post"><div class="row g-3"><div class="col-md-6"><label class="form-label">Proveedor</label><select class="form-select" name="supplierId" required>@foreach(var s in suppliers.Where(x=>x.Active)){<option value="@s.Id">@s.Name - @s.TaxId</option>}</select></div><div class="col-md-6"><label class="form-label">Producto</label><select class="form-select" name="productId" required>@foreach(var p in products.Where(x=>x.Active)){<option value="@p.Id">@p.Code - @p.Name (stock @p.Stock)</option>}</select></div><div class="col-md-6"><label class="form-label">Cantidad</label><input class="form-control" type="number" min="1" name="quantity" value="1" required></div><div class="col-md-6"><label class="form-label">Costo unitario (S/)</label><input class="form-control" type="number" min="0.01" step="0.01" name="unitCost" required></div></div><hr class="my-4"><div class="d-flex justify-content-end"><button class="btn btn-primary px-4"><i class="bi bi-check2-circle"></i> Registrar compra</button></div></form></div>