@* archivo: _layout.cshtml | función: plantilla general que contiene la estructura visual compartida por las páginas del sistema. *@
<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>@ViewData["Title"] - Tienda de Abarrotes</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<link href="~/css/site.css" rel="stylesheet"></head>
<body>
@if(User.Identity?.IsAuthenticated==true){
<div class="app-shell"><aside class="sidebar"><div class="brand"><div class="brand-icon"><i class="bi bi-box-seam"></i></div><div><strong>TIENDA DE ABARROTES</strong><small>Gestión de Inventario</small></div></div>
<nav class="side-nav"><a href="/"><i class="bi bi-grid-1x2"></i> Dashboard</a><div class="nav-title">OPERACIONES</div><a href="/Sales"><i class="bi bi-cart-check"></i> Ventas</a><a href="/Purchases"><i class="bi bi-bag-plus"></i> Compras</a><a href="/Inventory"><i class="bi bi-arrow-left-right"></i> Movimientos</a><div class="nav-title">CATÁLOGOS</div><a href="/Products"><i class="bi bi-box"></i> Productos</a><a href="/Categories"><i class="bi bi-tags"></i> Categorías</a><a href="/Suppliers"><i class="bi bi-truck"></i> Proveedores</a><a href="/Customers"><i class="bi bi-people"></i> Clientes</a><div class="nav-title">CONTROL</div><a href="/Payments"><i class="bi bi-credit-card"></i> Pagos</a></nav>
<div class="sidebar-user"><div class="avatar">@(User.Identity?.Name?.Substring(0,1).ToUpper())</div><div><strong>@User.Identity?.Name</strong><small>Sesión activa</small></div><a href="/Account/Logout" title="Salir"><i class="bi bi-box-arrow-right"></i></a></div></aside>
<section class="content"><header class="topbar"><div><h5 class="m-0">@ViewData["Title"]</h5><small>Control comercial e inventario en tiempo real</small></div><span class="badge text-bg-light"><i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dd/MM/yyyy")</span></header><main class="page-content">@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}@if(TempData["Ok"]!=null){<div class="alert alert-success">@TempData["Ok"]</div>}@RenderBody()</main></section></div>
}else{<main>@RenderBody()</main>}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>