@model IEnumerable<AbarrotesInventory.Domain.Entities.Product>
@* archivo: index.cshtml | función: vista principal del módulo products, utilizada para mostrar y administrar sus registros. *@
@{ViewData["Title"]="Productos";}<div class="d-flex justify-content-between"><h2>Productos</h2><a class="btn btn-primary" href="/Products/Create">Nuevo producto</a></div><table class="table table-striped mt-3"><thead><tr><th>Código</th><th>Nombre</th><th>Stock</th><th>Compra</th><th>Venta</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var p in Model.Where(x=>x.Active)){<tr><td>@p.Code</td><td>@p.Name</td><td class="@(p.Stock<=p.MinStock?"text-danger fw-bold":"")">@p.Stock</td><td>@p.PurchasePrice.ToString("N2")</td><td>@p.SalePrice.ToString("N2")</td><td>Activo</td><td><a class="btn btn-sm btn-warning" href="/Products/Edit/@p.Id">Editar</a> <form method="post" action="/Products/Delete/@p.Id" class="d-inline"><button class="btn btn-sm btn-danger">Eliminar</button></form></td></tr>}</tbody></table>