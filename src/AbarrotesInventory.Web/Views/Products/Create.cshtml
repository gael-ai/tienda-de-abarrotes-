@model AbarrotesInventory.Domain.Entities.Product
@* archivo: create.cshtml | función: vista del módulo products utilizada para registrar un nuevo elemento. *@
@{ViewData["Title"]="Producto";}<h2>Nuevo producto</h2><form method="post"><div class="row g-3"><div class="col-md-4"><label>Código</label><input class="form-control" asp-for="Code" required></div><div class="col-md-8"><label>Nombre</label><input class="form-control" asp-for="Name" required></div><div class="col-md-4"><label>Categoría</label><select class="form-select" asp-for="CategoryId" asp-items="@(new SelectList(ViewBag.Categories,"Id","Name"))"></select></div><div class="col-md-4"><label>Precio compra</label><input class="form-control" asp-for="PurchasePrice"></div><div class="col-md-4"><label>Precio venta</label><input class="form-control" asp-for="SalePrice"></div><div class="col-md-4"><label>Stock inicial</label><input class="form-control" asp-for="Stock"></div><div class="col-md-4"><label>Stock mínimo</label><input class="form-control" asp-for="MinStock"></div><div class="col-md-4"><label>Unidad</label><input class="form-control" asp-for="Unit"></div></div><button class="btn btn-primary mt-3">Guardar</button> <a class="btn btn-secondary mt-3" href="/Products">Cancelar</a></form>