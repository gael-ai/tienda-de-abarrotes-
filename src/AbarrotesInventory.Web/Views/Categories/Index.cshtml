@model IEnumerable<AbarrotesInventory.Domain.Entities.Category>
@* archivo: index.cshtml | función: vista principal del módulo categories, utilizada para mostrar y administrar sus registros. *@
@{ViewData["Title"]="Categorías";}<h2>Categorías</h2><form method="post" action="/Categories/Save" class="row g-2 mb-4"><div class="col"><input class="form-control" name="Name" placeholder="Name" required></div><div class="col"><input class="form-control" name="Description" placeholder="Description" required></div><div class="col-auto"><button class="btn btn-primary">Agregar</button></div></form><table class="table"><thead><tr><th>Name</th><th>Description</th><th></th></tr></thead><tbody>@foreach(var e in Model.Where(x=>x.Active)){<tr><td>@e.Name</td><td>@e.Description</td><td><form method="post" action="/Categories/Delete/{e.Id}"><button class="btn btn-sm btn-danger">Eliminar</button></form></td></tr>}</tbody></table>