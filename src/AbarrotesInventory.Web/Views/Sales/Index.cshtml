@model IEnumerable<AbarrotesInventory.Domain.Entities.Sale>
@* archivo: index.cshtml | función: vista principal del módulo sales, utilizada para mostrar y administrar sus registros. *@
@{ViewData["Title"]="Ventas";}<div class="d-flex justify-content-between"><h2>Ventas</h2><a class="btn btn-primary" href="/Sales/Create">Registrar venta</a></div><table class="table mt-3"><thead><tr><th>Número</th><th>Fecha</th><th>Cliente</th><th>Total</th><th>Pago</th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.Number</td><td>@s.Date</td><td>@s.Customer?.Name</td><td>S/ @s.Total.ToString("N2")</td><td>@s.PaymentMethod</td></tr>}</tbody></table>