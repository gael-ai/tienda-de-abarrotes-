@* archivo: create.cshtml | función: vista del módulo sales utilizada para registrar un nuevo elemento. *@
@{ViewData["Title"]="Nueva venta";var products=(IEnumerable<AbarrotesInventory.Domain.Entities.Product>)ViewBag.Products;var customers=(IEnumerable<AbarrotesInventory.Domain.Entities.Customer>)ViewBag.Customers;}<div class="page-title-row"><div><h3>Registrar venta</h3><span class="text-secondary">Selecciona cliente, producto y forma de pago</span></div><a href="/Sales" class="btn btn-outline-secondary">Volver</a></div><div class="card p-4"><form method="post"><div class="row g-3"><div class="col-md-6"><label class="form-label">Cliente</label><select class="form-select" name="customerId" required>@foreach(var c in customers.Where(x=>x.Active)){<option value="@c.Id">@c.Name - @c.Document</option>}</select></div><div class="col-md-6"><label class="form-label">Método de pago</label><select class="form-select" name="paymentMethod"><option>EFECTIVO</option><option>YAPE</option><option>PLIN</option><option>TARJETA</option><option>TRANSFERENCIA</option></select></div><div class="col-md-9"><label class="form-label">Producto</label><select class="form-select" name="productId" required>@foreach(var p in products.Where(x=>x.Active&&x.Stock>0)){<option value="@p.Id">@p.Code - @p.Name | Stock: @p.Stock | S/ @p.SalePrice.ToString("N2")</option>}</select></div><div class="col-md-3"><label class="form-label">Cantidad</label><input class="form-control" type="number" min="1" name="quantity" value="1" required></div></div><hr class="my-4"><div class="d-flex justify-content-end"><button class="btn btn-primary px-4"><i class="bi bi-check2-circle"></i> Confirmar venta</button></div></form></div>