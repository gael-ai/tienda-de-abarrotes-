@model IEnumerable<AbarrotesInventory.Domain.Entities.InventoryMovement>
@* archivo: index.cshtml | función: vista principal del módulo inventory, utilizada para mostrar y administrar sus registros. *@
@{ViewData["Title"]="Movimientos de inventario";}<div class="page-title-row"><div><h3 class="mb-1">Kardex de inventario</h3><span class="text-secondary">Historial de entradas y salidas de productos</span></div><form class="d-flex"><input class="form-control" name="q" placeholder="Buscar producto o referencia"><button class="btn btn-outline-primary ms-2">Buscar</button></form></div><div class="table-card"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cantidad</th><th>Stock anterior</th><th>Stock final</th><th>Referencia</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Date.ToString("dd/MM/yyyy HH:mm")</td><td><b>@x.Product?.Code</b> - @x.Product?.Name</td><td><span class="@(x.Type=="SALE"?"status-low":"status-ok")">@x.Type</span></td><td>@x.Quantity</td><td>@x.StockBefore</td><td><b>@x.StockAfter</b></td><td>@x.Reference</td></tr>}</tbody></table></div></div>